# Copy to .env.local (never commit it) to turn on the optional AI teachers.
# Usage is billed to your own account.
#
# OpenAI (https://platform.openai.com/api-keys): teacher replies, natural teacher
# voices and listening. Used when set.
OPENAI_API_KEY=
#
# Or Anthropic (https://console.anthropic.com): teacher replies only.
ANTHROPIC_API_KEY=

# Optional
# OPENAI_MODEL=gpt-6-luna
# AI_MODEL=claude-haiku-4-5-20251001
# AI_DAILY_LIMIT=300
# AI_HELPER_PORT=8787
